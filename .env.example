# Copia questo file in .env prima di andare in produzione:
#   cp .env.example .env

MYSQL_DATABASE=uniprojecthub
MYSQL_ROOT_PASSWORD=uph_dev_mysql_password_change_me

# Chiave simmetrica HMAC-SHA256 condivisa tra Auth e i microservizi (minimo 32 caratteri)
JWT_SECRET=uph_dev_jwt_secret_key_minimum_32_chars_change_me!!

# Porta esposta per API Gateway e Frontend
GATEWAY_PORT=8080
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:8080
