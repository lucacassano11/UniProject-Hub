{
  "Logging": { "LogLevel": { "Default": "Information" } },
  "ReverseProxy": {
    "Routes": {
      "auth":      { "ClusterId": "auth",      "Match": { "Path": "/api/auth/{**catch-all}" },      "Transforms": [ { "PathRemovePrefix": "/api/auth" } ] },
      "sessioni":  { "ClusterId": "sessioni",  "Match": { "Path": "/api/sessioni/{**catch-all}" },  "Transforms": [ { "PathRemovePrefix": "/api/sessioni" } ] },
      "gruppi":    { "ClusterId": "gruppi",    "Match": { "Path": "/api/gruppi/{**catch-all}" },    "Transforms": [ { "PathRemovePrefix": "/api/gruppi" } ] },
      "consegne":  { "ClusterId": "consegne",  "Match": { "Path": "/api/consegne/{**catch-all}" },  "Transforms": [ { "PathRemovePrefix": "/api/consegne" } ] },
      "log":       { "ClusterId": "log",       "Match": { "Path": "/api/log/{**catch-all}" },       "Transforms": [ { "PathRemovePrefix": "/api/log" } ] },
      "sicurezza": { "ClusterId": "sicurezza", "Match": { "Path": "/api/sicurezza/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/api/sicurezza" } ] },
      "notifiche": { "ClusterId": "notifiche", "Match": { "Path": "/api/notifiche/{**catch-all}" }, "Transforms": [ { "PathRemovePrefix": "/api/notifiche" } ] }
    },
    "Clusters": {
      "auth":      { "Destinations": { "d1": { "Address": "http://auth:8080" } } },
      "sessioni":  { "Destinations": { "d1": { "Address": "http://sessioni:8080" } } },
      "gruppi":    { "Destinations": { "d1": { "Address": "http://gruppi:8080" } } },
      "consegne":  { "Destinations": { "d1": { "Address": "http://consegne:8080" } } },
      "log":       { "Destinations": { "d1": { "Address": "http://log:8080" } } },
      "sicurezza": { "Destinations": { "d1": { "Address": "http://sicurezza:8080" } } },
      "notifiche": { "Destinations": { "d1": { "Address": "http://notifiche:8080" } } }
    }
  }
}
